{
  "$schema": "dpe/json/schema/library",
  "$libraries": {},
  
  "$templates": {
    "resourceLocationString": {
      "$params": {
        "schema": { "type": "string" },
        "allowTags": { "type": "boolean", "default": false },
        "onlyTags": { "type": "boolean", "default": false },
        "description": { "type": "string", "default": "A resource location in the form `namespace:path`." }
      },
      "$body": {
        "$type": "string",
        "type": "minecraft:resource_location",
        "args": { "schema": { "$ref": "#schema" }, "allowTags": { "$ref": "#allowTags" }, "onlyTags": { "$ref": "#onlyTags" } },
        "description": { "$ref": "#description" }
      }
    },

    "value_or_array": {
      "$params": {
        "element": { "type": "object" }
      },
      "$body": { 
        "$type": "union",
        "options": [
          { "$ref": "#element" },
          {
            "$type": "array",
            "element": { "$ref": "#element" }
          }
        ]
      }
    }
  },
  
  "$definitions": {
    
    "radians_angle": {
      "$type": "float",
      "description": "The angle in radians. \n- 360° = 2π radians ≈ 6.28 radians\n- 180° = π radians ≈ 3.14 radians\n- 90° = 0.5π radians ≈ 1.57 radians"
    },
    
    "block_pos": {
      "$type": "array",
      "element": { "$type": "integer" },
      "minCount": 3,
      "maxCount": 3,
      "description": "The block position. [X, Y, Z]"
    }
  }
}