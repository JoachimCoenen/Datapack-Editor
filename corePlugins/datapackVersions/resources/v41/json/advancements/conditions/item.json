{
  "$schema": "dpe/json/schema/library",
  "$libraries": {
    "base": "_base.json",
    "utils": "../../../common/utils-library.json",
    "data_components": "../../../nbt/data_components-library.json"
  },
  "$definitions": {
    "item": {
      "$type": "object",
      "properties": {
        "count": {
          "optional": true,
          "value": { "$ref": "base:valOrRange" },
          "description": "Amount of the item."
        },
        "durability": {
          "optional": true,
          "value": { "$ref": "base:valOrRange" },
          "description": "The durability of the item."
        },
        "enchantments": {
          "optional": true,
          "value": {
            "$type": "array",
            "element": {
              "$type": "object",
              "properties": {
                "enchantment": {
                  "optional": true,
                  "value": {"$ref": "utils:resourceLocationString", "schema": "enchantment" },
                  "description": "An [ [Java Edition data values#Enchantments|enchantment ID] ]."
                },
                "levels": {
                  "optional": true,
                  "value": { "$ref": "base:valOrRange" },
                  "description": "The level of the enchantment."
                }
              }
            }
          },
          "description": "List of enchantments."
        },
        "stored_enchantments": {
          "optional": true,
          "value": {
            "$type": "array",
            "element": {
              "$type": "object",
              "properties": {
                "enchantment": {
                  "optional": true,
                  "value": {"$ref": "utils:resourceLocationString", "schema": "enchantment" },
                  "description": "An [ [Java Edition data values#Enchantments|enchantment ID] ]."
                },
                "levels": {
                  "optional": true,
                  "value": { "$ref": "base:valOrRange" },
                  "description": "The level of the enchantment."
                }
              }
            }
          },
          "description": "List of stored enchantments."
        },
        "items": {
          "optional": true,
          "value": { 
            "$ref": "utils:value_or_array",
            "element": {"$ref": "utils:resourceLocationString", "schema": "item", "allowTags": true }
          },
          "description": "A list of [ [Java Edition data values#Items|item IDs] ]."
        },
        "components": {
          "optional": true,
          "value": { "$defRef": "data_components:data_components" },
          "description": "Matches exact item component values. Each key in this object corresponds to a component to test, with its value as the desired data to compare."
        },
        "custom_data": {
          "optional": true,
          "value": {
            "$type": "string",
            "type": "minecraft:nbt_compound_tag"
          },
          "description": "An NBT string."
        },
        "potions": {
          "optional": true,
          "value": { 
            "$ref": "utils:value_or_array",
            "element": {"$ref": "utils:resourceLocationString", "schema": "potion", "allowTags": true }
          },
          "description": "A [ [Potion#Item data|brewed potion ID] ]."
        }
      }
    }
  }
}